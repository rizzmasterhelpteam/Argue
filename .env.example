VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Server-only: never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
RATE_LIMIT_IP_SALT=

# Dodo Payments. Keep these server-only: never prefix them with VITE_.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Use test_mode during Dodo testing; omit or set live_mode for production.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_PRO_PRODUCT_ID=
# One-time $5 30-minute voice pack. It is fulfilled only from a verified Dodo webhook.
DODO_PAYMENTS_VOICE_PACK_PRODUCT_ID=
# Optional override. Defaults to Dodo's test or live API URL from DODO_PAYMENTS_ENVIRONMENT.
DODO_PAYMENTS_API_BASE_URL=
# Public canonical application URL, used for hosted checkout return and cancellation URLs.
APP_URL=https://argueai.vercel.app
